--- a/scripts/mqvpn-server-nat.sh	2026-08-28 19:58:05.903335059 +0900
+++ b/scripts/mqvpn-server-nat.sh	2026-08-28 19:59:11.649630721 +0900
@@ -112,35 +112,44 @@
 teardown() {
     echo "mqvpn-server-nat: teardown"
 
+    # 全インスタンスがホスト netns を共有するため、by-comment の一律削除だと
+    # 本コンテナの停止/再起動時に他インスタンスの NAT ルールまで消えてしまう。
+    # 本インスタンスの subnet に絞って削除する (subnet 未設定時は "." で全削除に fallback)。
+    local SUBNET="" SUBNET6=""
+    SUBNET=$(read_config_value subnet Subnet "")
+    SUBNET6=$(read_config_value subnet6 Subnet6 "")
+
     # Remove rules by line number (reverse order to avoid index shift)
     # This handles any rule shape as long as it has our comment tag
     delete_by_comment() {
-        local table="$1" chain="$2"
+        local table="$1" chain="$2" subnet="$3"
+        [ -z "$subnet" ] && subnet="."
         while true; do
             local line
             line=$(iptables -t "$table" -L "$chain" --line-numbers -n 2>/dev/null \
-                | grep "$COMMENT" | head -1 | awk '{print $1}')
+                | grep "$COMMENT" | grep -F "$subnet" | head -1 | awk '{print $1}')
             [ -z "$line" ] && break
             iptables -t "$table" -D "$chain" "$line" 2>/dev/null || break
         done
     }
 
-    delete_by_comment nat POSTROUTING
-    delete_by_comment filter FORWARD
+    delete_by_comment nat POSTROUTING "$SUBNET"
+    delete_by_comment filter FORWARD "$SUBNET"
 
     # Remove IPv6 FORWARD rules (unconditional — handles config changes between setup/teardown)
     delete_by_comment_v6() {
-        local table="$1" chain="$2"
+        local table="$1" chain="$2" subnet="$3"
+        [ -z "$subnet" ] && subnet="."
         while true; do
             local line
             line=$(ip6tables -t "$table" -L "$chain" --line-numbers -n 2>/dev/null \
-                | grep "$COMMENT" | head -1 | awk '{print $1}')
+                | grep "$COMMENT" | grep -F "$subnet" | head -1 | awk '{print $1}')
             [ -z "$line" ] && break
             ip6tables -t "$table" -D "$chain" "$line" 2>/dev/null || break
         done
     }
-    delete_by_comment_v6 nat POSTROUTING
-    delete_by_comment_v6 filter FORWARD
+    delete_by_comment_v6 nat POSTROUTING "$SUBNET6"
+    delete_by_comment_v6 filter FORWARD "$SUBNET6"
 
     # Restore forwarding settings
     if [ -f "$STATE_DIR/orig_ip_forward.$TUN_NAME" ]; then
