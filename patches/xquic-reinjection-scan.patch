 typedef struct {
     xqc_log_t              *log;
     xqc_connection_t       *conn;
+
+    /* per-scan caches (patched for perf). The unacked list is walked
+     * oldest-first, so the first packet younger than the computed deadline
+     * marks the watermark past which no packet can qualify in this scan
+     * (scan_gen / scan_seen_young). min_srtt and the derived deadline are
+     * loop invariants, cached per millisecond (cache_epoch_ms ...). Path
+     * class lookups for AFTER_SEND are cached one entry at a time. */
+    uint64_t    scan_gen;            /* last reinj_scan_generation seen */
+    xqc_bool_t  scan_seen_young;     /* age watermark armed for scan_gen */
+    xqc_usec_t  cache_epoch_ms;      /* monotonic ms when cache filled */
+    xqc_usec_t  cache_now_us;        /* monotonic us at cache fill */
+    double      cache_deadline;      /* deadline derived from min_srtt */
+    uint64_t    after_send_cache_pid;      /* last path id class-cached */
+    int         after_send_cache_class;    /* its perf class */
+    xqc_bool_t  after_send_cache_valid;
 } xqc_deadline_reinj_ctl_t;
 
 extern const xqc_reinj_ctl_callback_t xqc_deadline_reinj_ctl_cb;
