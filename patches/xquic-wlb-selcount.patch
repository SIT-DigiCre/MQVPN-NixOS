+/* measurement: dump cumulative per-path selection counters to a file at ~1Hz */
+static void
+wlb_sel_log(xqc_wlb_scheduler_t *s)
+{
+    time_t now = time(NULL);
+    if (now - s->last_sel_log_sec < 1)
+        return;
+    s->last_sel_log_sec = now;
+    char sel_log[256];
+    snprintf(sel_log, sizeof(sel_log), "/tmp/mqvpn_wlb_sel_%d.log", (int)getpid());
+    FILE *sfp = fopen(sel_log, "a");
+    if (sfp != NULL) {
+        for (int i = 0; i < s->n_paths; i++) {
+            fprintf(sfp, "ts=%lld path=%llu sel_bytes=%llu sel_pkts=%llu\n",
+                    (long long)now,
+                    (unsigned long long)s->paths[i].path_id,
+                    (unsigned long long)s->paths[i].sel_bytes,
+                    (unsigned long long)s->paths[i].sel_pkts);
+        }
+        fclose(sfp);
+    }
 }
 
