+/**
+ * §C: per-path pin efficiency — proven capacity (est_bw high-water mark from
+ * wlb_refresh_paths).  Used by wlb_pick_pin_path.  Returns max eff.
+ */
+static uint64_t
+wlb_pin_effs(xqc_wlb_scheduler_t *s, xqc_connection_t *conn,
+             uint64_t eff[WLB_MAX_PATHS])
+{
+    uint64_t max_peak = 0, max_eff = 0;
+    int i;
+
+    for (i = 0; i < s->n_paths; i++) {
+        if (s->paths[i].peak_rate > max_peak) {
+            max_peak = s->paths[i].peak_rate;
+        }
+    }
+
+    for (i = 0; i < s->n_paths; i++) {
+        /* §C: eff = measured delivery-rate peak, floored at half the best
+         * path's peak.  Pure measured-peak weighting has a self-fulfilling
+         * fixed point: under-provisioned paths measure low rates → get few
+         * flows → keep measuring low.  The 1/2 floor guarantees every path
+         * a real flow share so it can prove (or disprove) its capacity;
+         * truly dead paths are frozen by mqvpn's path state machine and
+         * never reach this loop. */
+        uint64_t e = s->paths[i].peak_rate;
+        if (max_peak == 0) {
+            e = 1;                          /* nothing proven yet: uniform */
+        } else if (e < max_peak / 2) {
+            e = max_peak / 2;
+        }
+        eff[i] = e;
+        if (e > max_eff) {
+            max_eff = e;
+        }
+    }
+    return max_eff;
+}
