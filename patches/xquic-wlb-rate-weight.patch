+     * warmup/sticky-pin phase.  Pairs with the rate-based weight (§2-A) to let
+     * equal-bandwidth paths aggregate. (chiken/mqvpn-wlb-distribution-and-bandwidth.md §2-B) */
+    uint64_t floor_w = max_w / 4;
+    if (floor_w < 1) {
+        floor_w = 1;
+    }
+    uint64_t min_eff = UINT64_MAX;
+    for (int i = 0; i < s->n_paths; i++) {
+        uint64_t eff = s->paths[i].weight;
+        if (eff < floor_w) {
+            eff = floor_w;
+        }
+        if (eff < min_eff) {
+            min_eff = eff;
+        }
+    }
+    if (min_eff == 0) {
+        min_eff = 1;
+    }
+
     for (int i = 0; i < s->n_paths; i++) {
-        int64_t quantum = (int64_t)(s->paths[i].weight / min_w);
+        uint64_t eff = s->paths[i].weight;
+        if (eff < floor_w) {
+            eff = floor_w;
+        }
