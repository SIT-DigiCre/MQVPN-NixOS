 /* ---------- path helpers ---------- */
@@ -559,8 +571,15 @@
     double N = late_estimate_dgram(T_us, (double)srtt_us,
                                    cwnd_pkts, ssthresh, loss);
 
-    /* Scale ×1000 to preserve precision in integer weight */
-    uint64_t weight = (uint64_t)(N * 1000.0);
+    /* Weight ∝ delivery RATE, not ∝ cwnd/BDP.
+     * N is the number of packets deliverable within window T_us; dividing by
+     * T_us yields packets/us = throughput.  The old weight = N*1000 made
+     * weight ∝ cwnd (BDP ∝ RTT), biasing the highest-RTT path and causing the
+     * single-path collapse (chiken/mqvpn-wlb-distribution-and-bandwidth.md §2-A).
+     * Rate-based weight gives equal-bandwidth paths ~equal WRR quanta so they
+     * aggregate instead of one path winning all pins. */
+    double rate_per_us = N / T_us;              /* packets per microsecond */
+    uint64_t weight = (uint64_t)(rate_per_us * 1e9);  /* pkts/sec, scale-invariant */
     return weight > 0 ? weight : 1;
 }
 
@@ -702,17 +721,47 @@
     }
 
     uint64_t min_w = UINT64_MAX;
+    uint64_t max_w = 0;
     for (int i = 0; i < s->n_paths; i++) {
