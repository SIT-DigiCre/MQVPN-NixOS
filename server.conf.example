{
  "control_listen": "127.0.0.1:9090",
  "mode": "server",
  "listen": "0.0.0.0:443",
  "subnet": "192.168.0.0/24",
  "tun_name": "mqvpn0",
  "cert_file": "/etc/mqvpn/server.crt",
  "key_file": "/etc/mqvpn/server.key",
  "auth_key": <!!todo!!>,
  "log_level": "info",
  "max_clients": 64,
  "scheduler": "wlb",
  "cc": "bbr",
  "reinjection": "off",
  "hybrid": {
    "enabled": false,
    "tcp": "auto",
    "tcp_max_flows": 2048
  }
}
